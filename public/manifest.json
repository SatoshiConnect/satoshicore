{
  "name": "NSAT Wallet — SatoshiCore",
  "short_name": "NSAT Wallet",
  "description": "Non-custodial NSAT wallet. Keys are generated and encrypted on this device; the gateway only relays already-signed envelopes.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a0c11",
  "theme_color": "#0a0c11",
  "categories": [
    "finance",
    "utilities",
    "games"
  ],
  "shortcuts": [
    {
      "name": "Open wallet",
      "short_name": "Wallet",
      "description": "Open the NSAT wallet",
      "url": "./"
    },
    {
      "name": "Pixel World",
      "short_name": "World",
      "description": "Open the pixel world",
      "url": "./world/"
    },
    {
      "name": "Chats",
      "short_name": "Chats",
      "description": "Open encrypted chats",
      "url": "./?view=chat"
    },
    {
      "name": "Receive NSAT",
      "short_name": "Receive",
      "description": "Open the receive screen",
      "url": "./?view=receive"
    }
  ],
  "share_target": {
    "action": "share/",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}

{
  "name": "NSAT Wallet — SatoshiCore",
  "short_name": "NSAT Wallet",
  "description": "Non-custodial NSAT wallet. Keys are generated and encrypted on this device; the gateway only relays already-signed envelopes.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./wallet/",
  "scope": "./",
  "id": "./wallet/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#050a14",
  "theme_color": "#050a14",
  "categories": ["finance", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
